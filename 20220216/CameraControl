bool DLP3010ControlPlugin::start()
{
    // 只有 LoadedState 才能 start。
    if (m_state != Cameras::State::LoadedState) {
        return false;
    }

    // 配置 TriggerOut1。
    if (!m_changed_triggerOut1Config) {
        DLPC34XX_WriteTriggerOutConfiguration(
            DLPC34XX_TT_TRIGGER1,
            m_parameters[TRIGGEROUT1ENABLE].toBool() ? DLPC34XX_TE_ENABLE : DLPC34XX_TE_DISABLE,
            m_parameters[TRIGGEROUT1INVERTED].toBool() ? DLPC34XX_TI_INVERTED : DLPC34XX_TI_NOT_INVERTED,
            m_parameters[TRIGGEROUT1DELAY].toInt()
        );
        m_changed_triggerOut1Config = true;
    }

    // 配置 TriggerOut2。项目上层主要启用 TriggerOut2，用于同步相机。
    if (!m_changed_triggerOut2Config) {
        DLPC34XX_WriteTriggerOutConfiguration(
            DLPC34XX_TT_TRIGGER2,
            m_parameters[TRIGGEROUT2ENABLE].toBool() ? DLPC34XX_TE_ENABLE : DLPC34XX_TE_DISABLE,
            m_parameters[TRIGGEROUT2INVERTED].toBool() ? DLPC34XX_TI_INVERTED : DLPC34XX_TI_NOT_INVERTED,
            m_parameters[TRIGGEROUT2DELAY].toInt()
        );
        m_changed_triggerOut2Config = true;
    }

    // 配置 TriggerIn。
    if (!m_changed_triggerInConfig) {
        DLPC34XX_WriteTriggerInConfiguration(
            m_parameters[TRIGGERINENABLE].toBool() ? DLPC34XX_TE_ENABLE : DLPC34XX_TE_DISABLE,
            m_parameters[TRIGGERINPOLARITY].toBool() ? DLPC34XX_TP_ACTIVE_HI : DLPC34XX_TP_ACTIVE_LOW
        );
        m_changed_triggerInConfig = true;
    }

    // 配置 LED。这里只打开蓝光通道，并设置蓝光电流。
    if (!m_changed_writeRgbLedCurrent) {
        DLPC34XX_WriteRgbLedEnable(false, false, true);
        DLPC34XX_WriteRgbLedCurrent(
            0x03E8,
            0x03E8,
            uint16_t(m_parameters[LIGHTBLUECURRENTVALUE].toUInt())
        );
        m_changed_writeRgbLedCurrent = true;
    }

    // 切换到内部 Pattern 投影模式。
    if (!m_changed_writeOperatingModeSelect) {
        DLPC34XX_WriteOperatingModeSelect(DLPC34XX_OM_SENS_INTERNAL_PATTERN);
        m_changed_writeOperatingModeSelect = true;
    }

    // 当前项目只使用软件触发内部 pattern。
    m_grapLoop = Cameras::GrapLoop::UserGrabLoop;
    m_triggerMode = Cameras::TriggerMode::SoftwareTrigger;

    return true;
}
