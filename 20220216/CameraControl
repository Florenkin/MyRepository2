```

`ImagingControlPlugin::openCamAndProj()` 会同时打开相机和光机。光机通过 `Cameras` 统一接口打开，所以在项目里光机也被抽象成一种 `Cameras` 插件设备。

```cpp
bool ImagingControlPlugin::openCamAndProj()
{
    // 省略相机数量和相机 ID 校验代码。

    // 创建光机控制对象。这里使用 Cameras 统一接口，不直接依赖 DLP3010 或 DLP4710。
    bool proj_is_virtual = true;
    cs_projector = new Cameras();

    // 根据配置文件中的 projector_ID 打开光机。
    // projector_ID 通常类似：
    // - dlp3010-xxxx
    // - dlp4710-xxxx
    if (cs_projector->open(cs_paramForCP->projector_ID, Cameras::PixelFormat::GRAY8, 0)) {
        // 开启或关闭底层调试输出。
        cs_projector->setParameter("EnableDebug", QVariant::fromValue(cs_isDebug));

        // 设置蓝光最大电流上限。底层插件会调用 DLPC34XX_WriteRgbLedMaxCurrent。
        cs_projector->setParameter("LightBlueCurrentValueMax", QVariant::fromValue(850));

        // 记录当前光机 ID，用于后续标定、几何文件和日志。
        cs_projectorID = cs_projector->deviceInfo().toStdString();
        proj_is_virtual = false;
    } else {
        // 如果配置为 no device，则走虚拟模式；否则认为光机打开失败。
        delete cs_projector;
        cs_projector = nullptr;
        if (cs_paramForCP->projector_ID == NOCAMERAORPROJECTORDEVICE) {
            cs_projectorID = "dlp3010-20221101";
            proj_is_virtual = true;
        } else {
            closeCamAndProj();
            emit printSignal("Projector was opened failed...");
            return false;
        }
    }

    // 省略后续打开侧相机、中心相机和状态设置代码。
    return true;
}
```

## 3. 成像控制层：配置投影图案、曝光、电流和触发

原始位置：

```text
D:\code\20220216\multi-view_ips\src\comps\imaging\plugin\imagingcontrolplugin.cpp:2368
```

`loadPatterns()` 是上层配置光机最关键的函数。它会根据当前流程是标定、扫描还是无标定扫描，决定投影图案数量、方向、相移次数、灰码数量，然后把曝光、电流和触发配置下发给光机插件。

```cpp
bool ImagingControlPlugin::loadPatterns()
{
    // 未打开设备或虚拟模式时，不真正加载光机图案。
    if (!cs_isOpenCandP || isVirtualMode()) {
        emit printSignal("Have not opened the camera and projector");
        return false;
    }

    // 如果正在扫描，禁止重新配置图案。
    if (cs_isWoring) {
        emit printSignal("It's working, please waiting to be finished...");
        return false;
    }

    // 配置图案前先停止光机。
    if (!cs_projector->stop()) {
        return false;
    }

    // 根据不同流程设置结构光 pattern 参数。
    switch (cs_patternsType) {
    case ProjectPatternType::NoCalibNoScan:
        // 只投垂直方向图案，通常用于简单测试或未标定流程。
        cs_projector->setParameter("InvertIncluded", QVariant::fromValue(false));
        cs_projector->setParameter("CentreCameraIncluded", QVariant::fromValue(hasCentreCamera()));
        cs_projector->setParameter("PhaseVerticalRepeatNum", QVariant::fromValue(1));
        cs_projector->setParameter("PhaseHorizontalRepeatNum", QVariant::fromValue(0));
        cs_projector->setParameter("GrayCodeVerticalNum", QVariant::fromValue(10));
        cs_projector->setParameter("GrayCodeHorizontalNum", QVariant::fromValue(0));
        cs_projector->setParameter("PhaseVerticalPixelPeriod", QVariant::fromValue(32));
        cs_projector->setParameter("PhaseHorizontalPixelPeriod", QVariant::fromValue(32));
        break;

    case ProjectPatternType::Calibration:
        // 标定模式下，图案参数来自 dlp::Calibration::Projector。
        cs_projector->setParameter("InvertIncluded", QVariant::fromValue(true));
        cs_projector->setParameter("CentreCameraIncluded", QVariant::fromValue(hasCentreCamera()));
        cs_projector->setParameter("PhaseVerticalRepeatNum", QVariant::fromValue(cs_projector_calib->phase_repeat_num_v_h_[0]));
        cs_projector->setParameter("PhaseHorizontalRepeatNum", QVariant::fromValue(cs_projector_calib->phase_repeat_num_v_h_[1]));
        cs_projector->setParameter("GrayCodeVerticalNum", QVariant::fromValue(cs_projector_calib->gray_code_pic_num_v_h_[0]));
        cs_projector->setParameter("GrayCodeHorizontalNum", QVariant::fromValue(cs_projector_calib->gray_code_pic_num_v_h_[1]));
        break;

    case ProjectPatternType::Scan:
        // 扫描模式下，图案参数来自已加载的几何配置 cs_geometry。
        cs_projector->setParameter("InvertIncluded", QVariant::fromValue(cs_geometry.gray_code_invert_included_));
        cs_projector->setParameter("CentreCameraIncluded", QVariant::fromValue(hasCentreCamera()));
        cs_projector->setParameter("PhaseVerticalRepeatNum", QVariant::fromValue(cs_geometry.phase_repeat_num_v_h_[0]));
        cs_projector->setParameter("PhaseHorizontalRepeatNum", QVariant::fromValue(cs_geometry.phase_repeat_num_v_h_[1]));
        cs_projector->setParameter("GrayCodeVerticalNum", QVariant::fromValue(cs_geometry.gray_code_pic_num_v_h_[0]));
        cs_projector->setParameter("GrayCodeHorizontalNum", QVariant::fromValue(cs_geometry.gray_code_pic_num_v_h_[1]));
        cs_projector->setParameter("PhaseVerticalPixelPeriod", QVariant::fromValue(cs_geometry.phase_pixels_per_period_v_h_[0]));
        cs_projector->setParameter("PhaseHorizontalPixelPeriod", QVariant::fromValue(cs_geometry.phase_pixels_per_period_v_h_[1]));
        break;
    }

    // 是否从预生成文件加载 pattern。
    // DLP4710 支持 LoadPatternFromFile，DLP3010 代码中没有这个参数。
    cs_projector->setParameter("LoadPatternFromFile", QVariant::fromValue(cs_paramForCP->projSetParam.patternFromFile));

    // 设置曝光时间和暗场时间。
    cs_projector->setParameter("IlluminationTime", QVariant::fromValue(cs_paramForCP->projSetParam.illuminationTime));
    cs_projector->setParameter("PreIlluminationDarkTime", QVariant::fromValue(cs_paramForCP->projSetParam.preIlluminationDarkTime));
    cs_projector->setParameter("PostIlluminationDarkTime", QVariant::fromValue(cs_paramForCP->projSetParam.postIlluminationDarkTime));

    // 设置蓝光 LED 电流。
    cs_projector->setParameter("LightBlueCurrentValue", QVariant::fromValue(cs_paramForCP->projSetParam.lightBlueCurrentValue));

    // 触发底层插件生成、写入或加载 pattern。
    if (!cs_projector->setParameter("UploadPatternSet", QVariant())) {
        return false;
    }

    // 设置触发输入输出。
    // 当前逻辑关闭 TriggerIn，打开 TriggerOut2，通常用于同步相机曝光。
    cs_projector->setParameter("TriggerInEnable", QVariant::fromValue(false));
    cs_projector->setParameter("TriggerInPolarity", QVariant::fromValue(cs_paramForCP->projSetParam.triggerInPolarity));
    cs_projector->setParameter("TriggerOut1Enable", QVariant::fromValue(false));
    cs_projector->setParameter("TriggerOut2Enable", QVariant::fromValue(true));
    cs_projector->setParameter("TriggerOut2Inverted", QVariant::fromValue(cs_paramForCP->projSetParam.triggerOut2Invert));
    cs_projector->setParameter("TriggerOut2Delay", QVariant::fromValue(cs_paramForCP->projSetParam.triggerOut2Delay));

    return true;
}
```

## 4. 成像控制层：启动和触发光机

原始位置：

```text
D:\code\20220216\multi-view_ips\src\comps\imaging\plugin\imagingcontrolplugin.cpp:2427
D:\code\20220216\multi-view_ips\src\comps\imaging\plugin\imagingcontrolplugin.cpp:2515
```

启动设备时，上层调用 `cs_projector->start()`。这会进入 DLP 插件的 `start()`，下发触发配置、LED 电流和内部 Pattern 模式。

```cpp
bool ImagingControlPlugin::startAllDevices()
{
    switch (cs_device_state) {
    case DeviceState::RealHasCentreCamera:
        // DisplayRepeatTime 为 0，表示 pattern 显示重复次数由底层定义或连续模式处理。
        cs_projector->setParameter("DisplayRepeatTime", QVariant::fromValue(0));

        // start() 不立即开始投影图案序列，而是把光机设置到可投影状态：
        // - 配置 TriggerOut
        // - 配置 TriggerIn
        // - 配置蓝光电流
        // - 切到 Internal Pattern 模式
        if (!cs_projector->start()) {
            emit printSignal("Error in starting projector");
            return false;
        }
        break;

    case DeviceState::RealNoCentreCamera:
        cs_projector->setParameter("DisplayRepeatTime", QVariant::fromValue(0));
        if (!cs_projector->start()) {
            emit printSignal("Error in starting projector");
            return false;
        }
        break;

    default:
        break;
    }

    return true;
}
```

真正触发一次投影图案序列的是 `grab()`：

```cpp
bool ImagingControlPlugin::devicesGrabOnce()
{
    // 先触发侧相机准备采图。
    for (uint32_t i = 0; i < cs_paramForCP->sideCameraNum; i++) {
        cs_sideCamera_vec[i]->grab();
    }

    switch (cs_device_state) {
    case DeviceState::RealHasCentreCamera:
        // 有中心相机时，先抓中心相机，再等待中心相机曝光完成，然后触发光机。
        cs_centreCamera->grab();
        timer.start();
        while (!timer.hasExpired(int(QVariant(cs_paramForCP->centreCamSetParam.exposureTime).toDouble() / 1000) + 5)) {
            QCoreApplication::processEvents();
        }
        cs_projector->grab();
        break;

    case DeviceState::RealNoCentreCamera:
        // 没有中心相机时，直接触发光机投影图案序列。
        cs_projector->grab();
        break;

    default:
        break;
    }

    return true;
}
```

