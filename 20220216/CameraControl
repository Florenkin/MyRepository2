bool DLP3010ControlPlugin::setParameter(const QString key, const QVariant &value)
{
    // 光机必须处于 LoadedState 才允许设置参数。
    if (m_state != Cameras::State::LoadedState) {
        return false;
    }

    // 不支持的参数直接失败。
    if (!m_parameters.contains(key)) {
        return false;
    }

    // 先把参数写入内存 map。
    m_parameters[key] = value;

    if (key == UPLOADPATTERNSET) {
        // 生成结构光图案，写入或加载到光机。
        if (!generatePatterns()) {
            return false;
        }
        m_uploadedPatternSet = true;
    }

    if (key == UPGRADEPATTERNTABLEDATA) {
        // 图案已经上传后，更新 pattern table 中的曝光和暗场时间等信息。
        if (m_uploadedPatternSet) {
            UpgradePatternTableData();
        }
    }

    if (key == ILLUMINATIONTIME) {
        // 校验曝光时间，读取光机要求的最小前后暗场时间。
        DLPC34XX_ValidateExposureTime_s validateExposureTime;
        if (DLPC34XX_ReadValidateExposureTime(
                DLPC34XX_PM_INTERNAL,
                DLPC34XX_ST_EIGHT_BIT_MONO,
                m_parameters[ILLUMINATIONTIME].toUInt(),
                &validateExposureTime)) {
            return false;
        }

        m_parameters[PREILLUMINATIONDARKTIMEMIN] =
            QVariant::fromValue(uint32_t(validateExposureTime.PreExposureDarkTime));
        m_parameters[POSTILLUMINATIONDARKTIMEMIN] =
            QVariant::fromValue(uint32_t(validateExposureTime.PostExposureDarkTime));
    }

    if (key == LIGHTBLUECURRENTVALUE) {
        // 限制蓝光电流不能超过光机支持的最大值。
        uint16_t redValue, greenValue, blueValue;
        DLPC34XX_ReadRgbLedMaxCurrent(&redValue, &greenValue, &blueValue);
        if (blueValue < value.toUInt()) {
            m_parameters[key] = QVariant::fromValue(uint32_t(blueValue));
        }
    }

    if (key == LIGHTBLUECURRENTVALUEMAX) {
        // 设置 RGB LED 最大电流，这里红绿为 0，仅设置蓝光最大值。
        uint16_t redValue = 0, greenValue = 0;
        if (DLPC34XX_WriteRgbLedMaxCurrent(redValue, greenValue, uint16_t(value.toUInt()))) {
            return false;
        }
    }

    // 这些参数变更后，在下一次 start() 中重新下发到硬件。
    if (key.contains("TriggerOut1")) {
        m_changed_triggerOut1Config = false;
    } else if (key.contains("TriggerOut2")) {
        m_changed_triggerOut2Config = false;
    } else if (key.contains("TriggerIn")) {
        m_changed_triggerInConfig = false;
    } else if (key.contains("CurrentValue")) {
        m_changed_writeRgbLedCurrent = false;
    }

    return true;
}
```

