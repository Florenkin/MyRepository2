bool DLP3010ControlPlugin::grab()
{
    // 必须先 start()，光机进入 ActiveState 后才能投影。
    if (m_state != Cameras::State::ActiveState) {
        return false;
    }

    // 先 reset 内部 pattern 控制器。
    DLPC34XX_WriteInternalPatternControl(DLPC34XX_PC_RESET, 0);

    // 启动内部 pattern 序列。
    // DISPLAYREPEATTIME 控制显示重复次数。
    DLPC34XX_WriteInternalPatternControl(
        DLPC34XX_PC_START,
        uint8_t(m_parameters[DISPLAYREPEATTIME].toUInt())
    );

    return true;
}
```

