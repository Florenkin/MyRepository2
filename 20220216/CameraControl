`Cameras` 是项目里的统一设备接口。相机和光机都通过它打开、启动、停止和触发。

```cpp
bool CMS::Cameras::open(const QByteArray &deviceInfo, CMS::Cameras::PixelFormat pixformat, uint32_t bufferSize)
{
    Q_D(Cameras);

    // 保存设备 ID，例如 dlp3010-xxx 或 dlp4710-xxx。
    if (d->p_deviceInfo.isEmpty()) {
        d->p_deviceInfo = deviceInfo;
        if (d->p_deviceInfo == "") {
            return false;
        }
    } else {
        return true;
    }

    // 保存像素格式和一次采集的 buffer 数量。
    d->p_pixelFormat = pixformat;
    d->p_bufferSize = bufferSize;

    // init() 会遍历 cameras 插件，根据 deviceInfo 找到 DLP3010 或 DLP4710 插件。
    return d->init();
}

bool CMS::Cameras::start()
{
    Q_D(Cameras);
    // 切换到 ActiveState，最终调用 DLP 插件的 start()。
    return d->setState(CMS::Cameras::State::ActiveState);
}

bool CMS::Cameras::stop()
{
    Q_D(Cameras);
    // 回到 LoadedState，最终调用 DLP 插件的 stop()。
    return d->setState(CMS::Cameras::LoadedState);
}

bool CMS::Cameras::grab()
{
    Q_D(Cameras);
    // 直接转发到 DLP 插件的 grab()，触发投影图案序列。
    if (d->p_control)
        return d->p_control->grab();
    return false;
}

bool CMS::Cameras::setParameter(const QString key, const QVariant &value)
{
    Q_D(Cameras);
    // 所有光机参数都通过字符串 key 下发。
    // 例如 IlluminationTime、LightBlueCurrentValue、TriggerOut2Delay。
    if (d->p_control)
        return d->p_control->setParameter(key, value);
    return false;
}
