bool DLP3010ControlPlugin::load(Cameras::PixelFormat pixformat, uint32_t bufferSize)
{
    // 先卸载旧状态，确保干净加载。
    if (!unload()) {
        return false;
    }

    try {
        // 初始化 TI DLPC 命令库，并连接 Cypress I2C。
        InitConnectionAndCommandLayer();

        // 请求 I2C 总线访问权。
        bool Status = CYPRESS_I2C_RequestI2CBusAccess();
        if (Status != true) {
            return false;
        }

        // 加载时先停止当前 pattern 投影。
        DLPC34XX_WriteInternalPatternControl(DLPC34XX_PC_STOP, 0);

        // 从设备或内部状态加载参数。
        loadParameters();
    } catch (...) {
        return false;
    }

    // 保存像素格式和重复显示次数。
    m_pixformat = pixformat;
    m_parameters[DISPLAYREPEATTIME] = QVariant::fromValue(bufferSize);

    return true;
}
```

