```cpp
bool DLP4710ControlPlugin::setParameter(const QString key, const QVariant &value)
{
    if (m_state != Cameras::State::LoadedState) {
        return false;
    }

    if (!m_parameters.contains(key)) {
        return false;
    }

    m_parameters[key] = value;

    if (key == UPLOADPATTERNSET) {
        // DLP4710 支持从预生成 bin 文件加载 pattern，也支持实时生成。
        if (m_parameters[LOADPATTERNFROMFILE].toBool()) {
            QString patternName = "pattern_" + QString::number(m_parameters[INVERTINCLUDED].toBool()) +
                    "_" + QString::number(m_parameters[CENTRECAMERAINCLUDED].toBool()) +
                    "_" + QString::number(m_parameters[PHASEVERTICALREPEATNUM].toInt()) +
                    "_" + QString::number(m_parameters[PHASEHORIZONTALREPEATNUM].toInt()) +
                    "_" + QString::number(m_parameters[GRAYCODEVERTICALNUM].toInt()) +
                    "_" + QString::number(m_parameters[GRAYCODEHORIZONTALNUM].toInt()) +
                    ".bin";

            if (!LoadPreBuildPatternData(patternName.toUtf8().data())) {
                PopulatePatternSetData2File();
                return false;
            }
            LoadPatternOrderTableEntryfromFlash();
        } else {
            if (!generatePatterns()) {
                return false;
            }
        }
        m_uploadedPatternSet = true;
    }

    if (key == UPGRADEPATTERNTABLEDATA) {
        if (m_uploadedPatternSet) {
            UpgradePatternTableData();
        }
    }

    if (key == ILLUMINATIONTIME) {
        // 校验曝光时间，并读取最小前后暗场时间。
        DLPC34XX_DUAL_ValidateExposureTime_s validateExposureTime;
        if (DLPC34XX_DUAL_ReadValidateExposureTime(
                DLPC34XX_DUAL_PM_INTERNAL,
                DLPC34XX_DUAL_ST_EIGHT_BIT_MONO,
                m_parameters[ILLUMINATIONTIME].toUInt(),
                &validateExposureTime)) {
            return false;
        }

        m_parameters[PREILLUMINATIONDARKTIMEMIN] =
            QVariant::fromValue(uint32_t(validateExposureTime.PreExposureDarkTime));
        m_parameters[POSTILLUMINATIONDARKTIMEMIN] =
            QVariant::fromValue(uint32_t(validateExposureTime.PostExposureDarkTime));
    }

    if (key == LIGHTBLUECURRENTVALUE) {
        // 限制蓝光电流不超过硬件最大值。
        uint16_t redValue, greenValue, blueValue;
        DLPC34XX_DUAL_ReadRgbLedMaxCurrent(&redValue, &greenValue, &blueValue);
        if (blueValue < value.toUInt()) {
            m_parameters[key] = QVariant::fromValue(uint32_t(blueValue));
        }
    }

    if (key == LIGHTBLUECURRENTVALUEMAX) {
        uint16_t redValue = 0, greenValue = 0;
        if (DLPC34XX_DUAL_WriteRgbLedMaxCurrent(redValue, greenValue, uint16_t(value.toUInt()))) {
            return false;
        }
    }

    // 标记对应配置需要在 start() 时重新写入硬件。
    if (key.contains("TriggerOut1")) {
        m_changed_triggerOut1Config = false;
    } else if (key.contains("TriggerOut2")) {
        m_changed_triggerOut2Config = false;
    } else if (key.contains("TriggerIn")) {
        m_changed_triggerInConfig = false;
    } else if (key.contains("CurrentValue")) {
        m_changed_writeRgbLedCurrent = false;
    }

    return true;
}
