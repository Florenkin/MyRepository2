这段代码来自设置界面的 Projector 页面。用户在界面里填写帧率、曝光时间、前后暗场时间、蓝光电流、触发参数后，点击 Set，会把这些值写入项目配置，并尝试校验光机可接受的曝光和电流范围。

```cpp
void WindowProjector::OnClickedSet()
{
    // 保存 HDR 开关。当前底层实现中 HDR 多处仍是 TODO，主要是配置占位。
    mProjectorDataPtr->SetHdrEnable(ui->checkBoxHdr->isChecked());

    // 读取 Trigger In 设置：是否启用、极性。
    // 注意：ImagingConfigs 中 TriggerIn.Enable 当前也是 TODO，占位意义大于实际下发。
    ProjectorTriggerIn triggerIn;
    triggerIn.Enable = ui->checkBoxTriggerIn->isChecked();
    triggerIn.Polar = (Polarity)ui->comboBoxTriggerInPolarity->currentIndex();
    mProjectorDataPtr->SetTriggerIn(triggerIn);

    // 读取 Pattern Ready 设置。当前项目中这部分同样偏配置占位。
    ProjectorPatternReady patternReady;
    patternReady.Enable = ui->checkBoxPatternReady->isChecked();
    patternReady.Polar = (Polarity)ui->comboBoxPatternReadyPolarity->currentIndex();
    mProjectorDataPtr->SetPatternReady(patternReady);

    // 读取 Trigger Out 设置。
    // 真正下发到光机的是 TriggerOut2Enable / TriggerOut2Inverted / TriggerOut2Delay。
    ProjectorTriggerOut triggerOut;
    triggerOut.Enable = ui->checkBoxTriggerOut->isChecked();
    triggerOut.Invert = ui->checkBoxTriggerOutInvert->isChecked();
    triggerOut.DelayUs = ui->labelTriggerOutDelay->text().toUInt();
    mProjectorDataPtr->SetTriggerOut(triggerOut);

    // 从 UI 读取光机核心参数：
    // - frameRate：帧率
    // - illuminationTime：投影曝光时间，单位 us
    // - preIlluminationDarkTime：曝光前暗场时间，单位 us
    // - postIlluminationDarkTime：曝光后暗场时间，单位 us
    // - lightBlueCurrentValue：蓝光 LED 电流
    IMGING::Imaging::ParamForCamAndProj param;
    param.projSetParam.lightBlueCurrentValue = ui->lineEditLedCurrentB->text().toUInt();
    param.projSetParam.frameRate = ui->lineEditFrameRate->text().toUInt();
    param.projSetParam.preIlluminationDarkTime = ui->lineEditPreTime->text().toUInt();
    param.projSetParam.illuminationTime = ui->lineEditExposureTime->text().toUInt();
    param.projSetParam.postIlluminationDarkTime = ui->lineEditPostTime->text().toUInt();

    // 调用成像控制模块校验并修正光机参数。
    // 例如：曝光时间太长时会降低有效帧率，蓝光电流超过上限时会回落到有效值。
    WindowSensor::GetInstance()->getSensorContrl()->updateCamAndProjParameters(&param);

    // 将校验后的帧率和曝光相关参数写回 UI。
    ui->lineEditFrameRate->setText(QString::number(param.projSetParam.frameRate));
    mProjectorDataPtr->SetFrameRateFs(ui->lineEditFrameRate->text().toUInt());

    ui->lineEditPreTime->setText(QString::number(param.projSetParam.preIlluminationDarkTime));
    ui->lineEditExposureTime->setText(QString::number(param.projSetParam.illuminationTime));
    ui->lineEditPostTime->setText(QString::number(param.projSetParam.postIlluminationDarkTime));

    // 保存曝光时间结构。
    ProjectorIlluminationTime proIllumTime;
    proIllumTime.PreDarkTimeUs = ui->lineEditPreTime->text().toUInt();
    proIllumTime.ExposureTimeUs = ui->lineEditExposureTime->text().toUInt();
    proIllumTime.PostDarkTimeUs = ui->lineEditPostTime->text().toUInt();
    mProjectorDataPtr->SetIlluminationTime(proIllumTime);

    // 保存 RGB LED 电流。实际 DLP 插件里主要使用 BlueCurrMa。
    ui->lineEditLedCurrentB->setText(QString::number(param.projSetParam.lightBlueCurrentValue));
    ProjectorRgbLedCurrent rgbLedCurrent;
    rgbLedCurrent.RedCurrMa = ui->lineEditLedCurrentR->text().toUInt();
    rgbLedCurrent.GreenCurrMa = ui->lineEditLedCurrentG->text().toUInt();
    rgbLedCurrent.BlueCurrMa = ui->lineEditLedCurrentB->text().toUInt();
    mProjectorDataPtr->SetRgbLedCurrent(rgbLedCurrent);

    // 写入 Multi-view_IpS.ini。
    this->mProjectorDataPtr->SaveConfig();
}
```

