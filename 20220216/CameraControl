bool DLP4710ControlPlugin::start()
{
    if (m_state != Cameras::State::LoadedState) {
        return false;
    }

    // 配置 TriggerOut1。
    if (!m_changed_triggerOut1Config) {
        DLPC34XX_DUAL_WriteTriggerOutConfiguration(
            DLPC34XX_DUAL_TT_TRIGGER1,
            m_parameters[TRIGGEROUT1ENABLE].toBool() ? DLPC34XX_DUAL_TE_ENABLE : DLPC34XX_DUAL_TE_DISABLE,
            m_parameters[TRIGGEROUT1INVERTED].toBool() ? DLPC34XX_DUAL_TI_INVERTED : DLPC34XX_DUAL_TI_NOT_INVERTED,
            m_parameters[TRIGGEROUT1DELAY].toInt()
        );
        m_changed_triggerOut1Config = true;
    }

    // 配置 TriggerOut2。
    if (!m_changed_triggerOut2Config) {
        DLPC34XX_DUAL_WriteTriggerOutConfiguration(
            DLPC34XX_DUAL_TT_TRIGGER2,
            m_parameters[TRIGGEROUT2ENABLE].toBool() ? DLPC34XX_DUAL_TE_ENABLE : DLPC34XX_DUAL_TE_DISABLE,
            m_parameters[TRIGGEROUT2INVERTED].toBool() ? DLPC34XX_DUAL_TI_INVERTED : DLPC34XX_DUAL_TI_NOT_INVERTED,
            m_parameters[TRIGGEROUT2DELAY].toInt()
        );
        m_changed_triggerOut2Config = true;
    }

    // 配置 TriggerIn。
    if (!m_changed_triggerInConfig) {
        DLPC34XX_DUAL_WriteTriggerInConfiguration(
            m_parameters[TRIGGERINENABLE].toBool() ? DLPC34XX_DUAL_TE_ENABLE : DLPC34XX_DUAL_TE_DISABLE,
            m_parameters[TRIGGERINPOLARITY].toBool() ? DLPC34XX_DUAL_TP_ACTIVE_HI : DLPC34XX_DUAL_TP_ACTIVE_LOW
        );
        m_changed_triggerInConfig = true;
    }

    // 只启用蓝光 LED，并写入蓝光电流。
    if (!m_changed_writeRgbLedCurrent) {
        DLPC34XX_DUAL_WriteRgbLedEnable(false, false, true);
        DLPC34XX_DUAL_WriteRgbLedCurrent(
            0x03E8,
            0x03E8,
            uint16_t(m_parameters[LIGHTBLUECURRENTVALUE].toUInt())
        );
        m_changed_writeRgbLedCurrent = true;
    }

    // 切换到内部 Pattern 模式。
    if (!m_changed_writeOperatingModeSelect) {
        DLPC34XX_DUAL_WriteOperatingModeSelect(DLPC34XX_DUAL_OM_SENS_INTERNAL_PATTERN);
        m_changed_writeOperatingModeSelect = true;
    }

    m_grapLoop = Cameras::GrapLoop::UserGrabLoop;
    m_triggerMode = Cameras::TriggerMode::SoftwareTrigger;

    return true;
}
